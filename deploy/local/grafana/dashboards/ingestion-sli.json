{
  "uid": "ingestion-connector",
  "title": "Ingestion SLA - Collector connector",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "ingestion",
    "sli"
  ],
  "description": "Completion-time rolling one-hour gauges. The exact 60-second fraction drives alerts; p50/p95/p99 use histogram interpolation. No data is unknown, never 100%.",
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "custom",
        "query": "local",
        "current": {
          "text": "local",
          "value": "local"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Completed paths (rolling 1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "ingestion-sli-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ingestion_sli:completed_1h{environment=\"$environment\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            }
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "table",
      "title": "Within 60s (rolling 1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "ingestion-sli-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * ingestion_sli:success_ratio_1h{environment=\"$environment\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            }
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Estimated p50 (rolling 1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "ingestion-sli-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, max by (environment, application, milestone, le) (ingestion_sli_window_duration_seconds_bucket{environment=\"$environment\"}))",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            }
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Estimated p95 (rolling 1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "ingestion-sli-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, max by (environment, application, milestone, le) (ingestion_sli_window_duration_seconds_bucket{environment=\"$environment\"}))",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            }
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Estimated p99 (rolling 1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "ingestion-sli-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, max by (environment, application, milestone, le) (ingestion_sli_window_duration_seconds_bucket{environment=\"$environment\"}))",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            }
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Correlation quality",
      "datasource": {
        "type": "prometheus",
        "uid": "ingestion-sli-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (environment, reason) (ingestion_sli_correlation_quality{environment=\"$environment\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            }
          }
        }
      ]
    }
  ]
}
